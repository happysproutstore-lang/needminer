# Copy to .env (never commit .env) or export in your shell. All values are optional.

# Sent as the HTTP User-Agent to public APIs.
NEED_SCANNER_USER_AGENT=need-scanner/0.1 (contact: you@example.com)
NEED_SCANNER_HTTP_TIMEOUT=20
NEED_SCANNER_OUTPUT_DIR=reports

# Optional LLM grouping (off by default). 1 = on.
NEED_SCANNER_LLM=0
GEMINI_API_KEY=your-gemini-api-key-here
NEED_SCANNER_GEMINI_MODEL=gemini-flash-lite-latest

# Optional Stack Exchange app key (raises the anonymous 300 requests/day quota).
STACKEXCHANGE_KEY=your-stackexchange-key-here

# Google Trends rate-limit cooldown (only used with --trends).
NEED_SCANNER_TRENDS_STATE=.cache/trends_429.json
NEED_SCANNER_TRENDS_COOLDOWN_HOURS=6
